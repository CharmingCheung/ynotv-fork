{
  "name": "ynotv",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop IPTV player with mpv",
  "homepage": "https://github.com/CharmingCheung/ynotv-fork",
  "author": {
    "name": "CharmingCheung"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:native-dash": "node scripts/dev-native-dash.mjs",
    "native:dev": "node scripts/native-dev.mjs",
    "setup:native-runtime": "node scripts/setup-native-runtime.mjs",
    "prepare:macos-runtime": "node scripts/prepare-macos-bundle-runtime.mjs",
    "dev:clean": "node scripts/kill-dev.js && pnpm dev",
    "kill-port": "node scripts/kill-dev.js",
    "build": "node scripts/check-jellyfin-init-script.mjs && pnpm -r build",
    "build:macos": "pnpm build:macos:local && pnpm audit:macos-bundle",
    "build:macos:local": "node scripts/prepare-dev.mjs && pnpm tauri build --bundles dmg --ci --config '{\"bundle\":{\"createUpdaterArtifacts\":false}}'",
    "audit:macos-bundle": "node scripts/audit-macos-bundle.mjs",
    "css:audit": "node scripts/check-globals.mjs && node scripts/audit-tokens.mjs && node scripts/check-modern-scoped.mjs && node scripts/check-de-stack.mjs && node scripts/check-css.mjs packages/ui/src",
    "typecheck": "pnpm css:audit && node scripts/check-jellyfin-init-script.mjs && pnpm -r typecheck",
    "setup:libmpv": "node scripts/setup-native-runtime.mjs",
    "tauri": "pnpm --filter @ynotv/app tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.3.0",
    "wait-on": "^9.0.3"
  },
  "packageManager": "pnpm@9.1.0"
}
